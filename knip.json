{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "hqptuner/static/app.js",
    "mockup/scripts/main.js",
    "scripts/eqstage/eqstage.js",
    "tests/js/**/*.test.js",
    "tests/js/support/vendor-resolve.js"
  ],
  "project": ["hqptuner/static/**/*.js", "mockup/scripts/**/*.js", "scripts/eqstage/**/*.js", "tests/js/**/*.js"],
  "ignore": ["hqptuner/static/vendor/**", "mockup/**"],
  "ignoreDependencies": ["prettier", "jscpd"],
  "exclude": ["unlisted", "binaries"]
}
