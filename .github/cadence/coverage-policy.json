{
  "scope": "integrated",
  "coverage": {
    "lines": 95,
    "branches": 90,
    "statements": 0,
    "include": ["hqptuner/**"],
    "exclude": ["tests/**", "hqptuner/static/vendor/**"],
    "commands": [
      ".venv/bin/pytest -m \"not live and not e2e\" -q --cov=hqptuner --cov-branch --cov-report=json:.coverage.json",
      "node .github/cadence/coverage-report-check.mjs --format python --report .coverage.json",
      "node --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='**/vendor/**' --test-coverage-lines={lines} --test-coverage-branches={branches} --test-coverage-functions=85 --import ./tests/js/support/vendor-resolve.js --test tests/js/*/*.test.js tests/js/*/*/*.test.js"
    ]
  },
  "strong_areas": [
    "hqptuner/lanes/",
    "hqptuner/conf/",
    "hqptuner/engine/",
    "hqptuner/presets/store/",
    "hqptuner/desktop.py",
    "packaging/",
    "hqptuner/static/lib/dom.js"
  ],
  "required_jobs": ["check", "e2e", "smoke", "lifecycle-deb", "lifecycle-rpm", "smoke-macos", "smoke-windows"]
}
