{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["scripts/eqlab/**/*.js", "scripts/eqstage/**/*.js", "tests/js/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
