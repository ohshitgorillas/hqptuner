    "neg_corr_mean_30_180": { "kind": "mean_signed", "range": [30, 180] },
    "neg_corr_200_510": { "kind": "mean_signed", "range": [200, 510] },
    "neg_corr_510_800": { "kind": "mean_signed", "range": [510, 800] },
    "neg_corr_800_2300": { "kind": "mean_signed", "range": [800, 2300] },
    "neg_corr_2300_2700": { "kind": "mean_signed", "range": [2300, 2700] },
    "neg_corr_2700_5200": { "kind": "mean_signed", "range": [2700, 5200] },
    "neg_corr_5200_6500": { "kind": "mean_signed", "range": [5200, 6500] },
    "neg_corr_6500_7500": { "kind": "mean_signed", "range": [6500, 7500] },
    "neg_corr_7500_9000": { "kind": "mean_signed", "range": [7500, 9000] },
