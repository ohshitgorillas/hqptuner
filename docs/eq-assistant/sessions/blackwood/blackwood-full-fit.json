{
  "chain": { "bands": [] },
  "target": {
    "from": "difference",
    "a": { "from": "flat" },
    "b": {
      "from": "points", "path": "docs/eq-assistant/sessions/blackwood/BlackwoodR.txt", "format": "fr_text",
      "despike": { "window": 7, "threshold_db": 3 }
    },
    "smooth": { "octaves": 0.1667 },
    "align": { "at": 1000 }
  },
  "metrics": {
    "rmse_2k_14k": { "kind": "rmse", "range": [2000, 14000], "domain": "erb" },
    "rmse_14k_17k": { "kind": "rmse", "range": [14000, 17000] },
    "res_2k_3k2": { "kind": "mean_signed", "range": [2000, 3200] },
    "res_3k2_5k2": { "kind": "mean_signed", "range": [3200, 5200] },
    "dev_5k2_7k5": { "kind": "maxdev_signed", "range": [5200, 7500] },
    "dev_7k5_10k5": { "kind": "maxdev_signed", "range": [7500, 10500] },
    "dev_10k5_14k": { "kind": "maxdev_signed", "range": [10500, 14000] },
    "dev_14k_17k": { "kind": "maxdev_signed", "range": [14000, 17000] },
    "res_400_2k": { "kind": "mean_signed", "range": [400, 2000] },
    "maxdev_2k_14k": { "kind": "maxdev", "range": [2000, 14000] }
  },
  "job": {
    "kind": "refine",
    "seed": {
      "append": [
        { "type": "peak", "f": 3050, "g": 3.0, "q": 1.8 },
        { "type": "peak", "f": 4150, "g": 6.0, "q": 1.3 },
        { "type": "peak", "f": 5900, "g": 4.5, "q": 1.2 },
        { "type": "peak", "f": 8850, "g": -6.0, "q": 3.0 },
        { "type": "peak", "f": 11900, "g": 6.0, "q": 1.6 },
        { "type": "hshelf", "f": 14000, "g": 4.0, "q": 0.7 }
      ]
    },
    "space": {
      "append": [
        { "type": "peak", "f": [2600, 3500, 25], "g": [1.0, 4.5, 0.25], "q": [1.0, 3.0, 0.1] },
        { "type": "peak", "f": [3800, 4500, 25], "g": [3.0, 6.0, 0.25], "q": [0.8, 2.0, 0.05] },
        { "type": "peak", "f": [5400, 6800, 25], "g": [2.0, 6.0, 0.25], "q": [0.8, 2.5, 0.1] },
        { "type": "peak", "f": [8400, 9300, 25], "g": [-6.0, -3.0, 0.25], "q": [2.0, 4.5, 0.1] },
        { "type": "peak", "f": [11200, 12800, 50], "g": [3.0, 6.0, 0.25], "q": [0.9, 2.5, 0.1] },
        { "type": "hshelf", "f": [13000, 15000, 100], "g": [1.0, 6.0, 0.25], "q": 0.7 }
