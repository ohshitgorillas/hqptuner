    "dev_12000_14000": { "kind": "maxdev_signed", "range": [12000, 14000] },
    "mean_2700_5200": { "kind": "mean_signed", "range": [2700, 5200] },
    "dev_5200_6500": { "kind": "maxdev_signed", "range": [5200, 6500] },
    "dev_6500_7500": { "kind": "maxdev_signed", "range": [6500, 7500] },
    "dev_7500_9000": { "kind": "maxdev_signed", "range": [7500, 9000] },
    "dev_9000_12000": { "kind": "maxdev_signed", "range": [9000, 12000] },
    "dev_14000_17000": { "kind": "maxdev_signed", "range": [14000, 17000] }
  },
  "job": {
    "kind": "search",
    "space": {
      "amend": [
        { "select": 6008.7, "g": [-4.5, -1.5, 1.5], "q": [2.5, 8] },
        { "select": 6907.9, "g": [-3.5, -0.5, 1.5], "q": [2.5, 8] },
        { "select": 7897.8, "g": [-5.0, -1.5, 1.75], "q": [2.5, 8] },
        { "select": 15566, "f": [15200, 16200, 500], "g": [-6.0, -2.0, 2.0], "q": [1.5, 6] }
      ],
      "append": [
        { "type": "peak", "f": [11000, 12000, 500], "g": [-4.0, -0.5, 1.75], "q": [3, 9] }
      ]
    },
    "constraints": [
      { "metric": "dev_12000_14000", "min": -8.5 },
      { "metric": "mean_2700_5200", "min": -0.75, "max": 0.75 }
    ],
    "objective": "minimize rmse_5k_12k + 0.5 * rmse_14k_17k",
    "refine": { "survivors": 3, "max_evals": 3000 },
    "top": 5
  }
