# virtualenv / python
.venv
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.json
.pytest-junit.xml
# last green run's wall time, the bar scripts/gates/check_suite_time.py holds the suite to
.suite-time.json
# per-test idle, written by scripts/idle_probe.py and judged by scripts/gates/check_idle.py
.idle-probe.json
# the smallest idle each test has been measured at, the record that gate converges
.idle-min.json
htmlcov/

# editor scratch — vim swap files for anything open in the tree
*.swp

# agent failures for internal training
docs/agent-failures.md

# Signalyst reference material — copyrighted, not redistributable.
# docs/vendor/manual/ is the pre-parsed form of the manual that agents read
# (scripts/build_manual.py, `make manual`) — derived from the same copyrighted
# source, so it stays out of the repo too. The script is tracked; its output is not.
hqplayer6desktop-manual.pdf
hqplayerd-readme.txt
docs/vendor/

# EQ Assistant research papers — copyrighted, not redistributable.
# Fetched by hand where automated retrieval failed; cited in docs/eq-assistant/SOURCES.md
# and read from these local copies. Keep them, never commit them.
docs/eq-assistant/*.pdf

# EQ Assistant working checklist — churns every session, local for now
docs/eq-assistant/todo.md

# scratch working docs — plans for a change in flight, one-off audit reports and
# handover briefs written for the agent that picks the work up. All of them are
# superseded by the commit that lands the change, and all of them are kept local
# so they can't dirty the tree at release time. The whole directory is scratch,
# so nothing inside it needs a pattern of its own. The three root patterns stay
# for a doc written beside the real docs before anyone files it.
docs/plans/
docs/*plan.md
docs/*audit.md
docs/*brief.md
/specs/

# EQ Assistant session dirs — measurement images, raw digitizations, and per-turn
# agent working files stay local. Only curated tuning JSONs are tracked.
docs/eq-assistant/sessions/**
!docs/eq-assistant/sessions/**/
!docs/eq-assistant/sessions/**/*tuning*.json

# runtime pre-apply settings backups
backups/

# HQPTuner-owned preset store — user data, not source. Anchored: unanchored, it
# also swallowed tests/presets/, so a new suite there was invisible to git and to
# the gates that run over `git ls-files`.
/presets/

# eqlab snapshot store — named chain JSON, user data, not source
data/eqlab/

# local hqplayerd credentials — never commit.
# Real file is hqpcreds; .env is a symlink to it that exists only so
# `docker compose` finds the ${HQPTUNER_HQP_*} substitutions in
# docker-compose.yaml. Both ignored.
hqpcreds
.env

# agent tooling — tracked, EXCEPT the per-machine bits below.
# Host-specific knowledge never lands here; it lives in a host skill.
.claude/settings.local.json
.claude/scheduled_tasks.lock
# analyzer output over this machine's session transcripts (scripts/budget_miner.py)
.claude/logs/
# per-session agent worktrees and scripts/pair.sh's state for them (branch
# points, the merge lock). Registered worktrees git already keeps out of
# status; the state files it would not.
.claude/worktrees/

# local docker test stack + its state
docker-compose.yaml
state/

# the gauntlet's artifacts. Approved specs and plans are tracked; drafts, reviewer
# rounds and the pair's red and merge evidence stay local. Anchored at the repo
# root so a bare name cannot swallow a same-named directory elsewhere.
/gauntlet/red/
/gauntlet/merge/
/gauntlet/reviews/
/gauntlet/plans/drafts/
/gauntlet/specs/drafts/

# node dev tooling (lint/format/dead-code gates) — dev-only, never shipped
node_modules

# setuptools build dir (pip wheel / python -m build), and PyInstaller's own
# output tree beside it (hqptuner.spec)
build/
dist/

# mutmut's working copies of the tree, one per mutant (make mutate)
mutants/
.mutmut-cache

# throwaway node scratch scripts (EQ tuning sessions and the like) — never
# shipped, and eslint skips them for the same reason
*.mjs

# LaTeX user guide, sources and build alike — it documents the wizard feature
# and lands when that does
docs/guide/

# local working data — EQ Lab saves and naming drafts, not repo content
# (the shipped static data lives in hqptuner/data/)
/data/

# correspondence kept alongside the work it informs, never repo content
/email*.txt

docs/filter-guide.md

# ad-hoc filter-cost probe and its captures — a local measurement scratchpad,
# not a repo probe (scripts/probes/ otherwise holds committed, gated scripts)
scripts/probes/probe_filter_cost.py
scripts/probes/filter_cost*.json
scripts/probes/record_apod.py
apod-log.tsv

# vendor installer kept for reference, 145 MiB and not ours to redistribute
/HQPlayer6Embedded-setup-*.exe

# junkburst scratch at the repo root: reports, logs, renders, eyes batch, throwaway scripts
/.junkburst*
