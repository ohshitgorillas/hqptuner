# virtualenv / python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# editor scratch — vim swap files for anything open in the tree
*.swp

# agent failures for internal training
docs/agent-failures.md

# Signalyst reference material — copyrighted, not redistributable.
# docs/vendor/manual/ is the pre-parsed form of the manual that agents read
# (scripts/build_manual.py, `make manual`) — derived from the same copyrighted
# source, so it stays out of the repo too. The script is tracked; its output is not.
hqplayer6desktop-manual.pdf
hqplayerd-readme.txt
docs/vendor/

# EQ Assistant research papers — copyrighted, not redistributable.
# Fetched by hand where automated retrieval failed; cited in docs/eq-assistant/SOURCES.md
# and read from these local copies. Keep them, never commit them.
docs/eq-assistant/*.pdf

# EQ Assistant working checklist — churns every session, local for now
docs/eq-assistant/todo.md

# runtime pre-apply settings backups
backups/

# HQPTuner-owned preset store — user data, not source
presets/

# eqlab snapshot store — named chain JSON, user data, not source
data/eqlab/

# local hqplayerd credentials — never commit.
# Real file is hqpcreds; .env is a symlink to it that exists only so
# `docker compose` finds the ${HQPTUNER_HQP_*} substitutions in
# docker-compose.yaml. Both ignored.
hqpcreds
.env

# agent tooling — tracked, EXCEPT the per-machine bits below.
# Host-specific knowledge never lands here; it lives in a host skill.
.claude/settings.local.json
.claude/scheduled_tasks.lock
# analyzer output over this machine's session transcripts (scripts/budget_miner.py)
.claude/logs/

# local docker test stack + its state
docker-compose.yaml
state/

# node dev tooling (lint/format/dead-code gates) — dev-only, never shipped
node_modules/

# setuptools build dir (pip wheel / python -m build)
build/

# mutmut's working copies of the tree, one per mutant (make mutate)
mutants/
.mutmut-cache
